DATABASE_URL=postgresql://grading:grading@127.0.0.1:55432/grading?schema=public

# AI 批改提供方。默认使用内置模拟评分；设为 volcengine 调用火山方舟真实模型。
AI_PROVIDER=mock
# 火山方舟 API Key，从 https://ark.volcengine.com/apikey 创建获取。
# ARK_API_KEY=
# 模型 ID 或推理接入点 ID，按已开通的模型填写。可在控制台「开通管理」或
# GET {ARK_BASE_URL}/models 查询账号可用的确切 ID（通常带日期后缀）。
# ARK_MODEL=deepseek-v4-1-flash-261017
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_TIMEOUT_MS=60000
# 自定义批改提示词（可选，支持多行，单引号包裹）。AI_SYSTEM_PROMPT 整体替换
# 「考官角色 + 评分细则」段；AI_PROMPT_EXTRA 添加补充要求。末尾的统一输出契约始终保留。
# 两者任一非空都会派生新的提示词版本，已有 AI 结果的任务将按新提示词重新批改。
# 大作文、小作文、口语分别使用 _TASK2、_TASK1、_SPEAKING 后缀。
# 专属变量未设置时回退到无后缀的全局值。省略全部覆盖时使用仓库内置提示词。
# AI_SYSTEM_PROMPT_TASK2='大作文评分说明'
# AI_SYSTEM_PROMPT_TASK1='小作文评分说明'
# AI_SYSTEM_PROMPT_SPEAKING='口语评分说明'
# AI_SYSTEM_PROMPT='你是……'
# AI_PROMPT_EXTRA='评分从严；评语面向学生，语气鼓励但直接。'
# 小作文（Task 1）图表题专用视觉模型：未配置时 Task 1 无法 AI 预批改，可人工评分。
# ARK_VISION_MODEL=doubao-xxx-vision

# 原考试平台只读接入。默认展示虚构答卷。
EXAM_READ_MODE=demo
# EXAM_PLATFORM_V_TOKEN=
# EXAM_PLATFORM_V_TOKEN_TYPE=e-n-p
# EXAM_PLATFORM_COOKIE=
# EXAM_LIVE_ROUNDS='[{"examUid":"E000","examRoundUid":"ER000","name":"测试轮次","teacherEmail":"teacher@your-school.example","autoDetectTasks":true,"taskTwoQuestionUids":[],"examHistoryIds":["000"]}]'
# 三个科目题目列表都留空时，该轮次自动识别科目：按答题卡内容判断口语与写作题
# （写作按题干 20/40 分钟或 150/250 词区分，口语整场一份批改）。
# 已配置题目 ID 的轮次可设 "autoDetectTasks":true，保留已配置题目并自动识别其他题目。

# 真实成绩回写开关。默认留空：确认提交只核对原平台答卷版本，不写入任何数据。
# 设为 1 后，确认提交会调用原平台 manualCorrect 接口写入总分 scoreLevel、评语 comment、
# 目标分卷（写作/口语）的项目分与逐题批改内容；其他分卷（听力/阅读）按答题卡原值原样回传。
# 开启前务必先用 examHistoryIds 限定测试答卷，并与原平台管理员确认多科目答卷的总分规则。
# EXAM_LIVE_WRITE=1
